msgid "Dosya Arşivim"
msgstr "File Archive"

msgid "Dosya Arşivim açılamadı. Ayrıntılar için NVDA günlüğünü kontrol edin."
msgstr "File Archive could not be opened. Check the NVDA log for details."

msgid "Etkin bir hesap bulunamadı. Giriş yapmak veya yeni bir hesap oluşturmak ister misiniz?"
msgstr "No active account was found. Would you like to sign in or create a new account?"

msgid "Sunucu isteği tamamlanamadı."
msgstr "The server request could not be completed."

msgid "Sunucuya bağlantı kurulamadı."
msgstr "A connection to the server could not be established."

msgid "Sunucu beklenmeyen bir yanıt gönderdi."
msgstr "The server sent an unexpected response."

msgid "İşlem tamamlanamadı."
msgstr "The operation could not be completed."

msgid "Kısa süre içinde çok fazla kod istendi. Lütfen bir süre bekleyip yeniden deneyin."
msgstr "Too many codes were requested in a short time. Please wait a while and try again."

msgid "Bu e-posta adresiyle kayıtlı bir hesap bulunamadı."
msgstr "No account was found for this email address."

msgid "Güvenlik belirteci alınamadı."
msgstr "The security token could not be obtained."

msgid "Oturum bilgisi kaydedilemedi."
msgstr "The session information could not be saved."

msgid "Oturum bilgisi silinemedi."
msgstr "The session information could not be deleted."

msgid "İşlem sırasında beklenmeyen bir hata oluştu."
msgstr "An unexpected error occurred during the operation."

